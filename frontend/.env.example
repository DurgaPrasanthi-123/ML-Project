# Copy to .env (Vite reads VITE_* at build/dev time; only non-secret config here).
# Empty value = same-origin relative paths, matching the Vite dev proxy and the
# nginx container. Set an absolute URL when the API is served from another origin.

# Local dev (uses the Vite proxy — leave empty):
VITE_API_URL=

# Example for a separate API host (no trailing slash):
# VITE_API_URL=https://phishing-url-api.onrender.com
