# Production build defaults — Vite loads this automatically for `vite build`
# (mode "production"), so a static deploy needs no dashboard configuration.
#
# Precedence: a real environment variable of the same name overrides this file
# (Vite applies process.env after the .env files). The Docker/Compose image
# sets VITE_API_URL="" explicitly, so it keeps using same-origin relative paths
# through the nginx proxy and is unaffected by the value below.

# Render backend service — no trailing slash.
VITE_API_URL=https://ml-6y5l.onrender.com
